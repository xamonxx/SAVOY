# SAVOY environment
# Copy to .env.local and fill only verified values.

# Canonical site origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=

# Business WhatsApp, international format without "+" or spaces.
# Leave blank until verified; CTAs fall back to the planner anchor.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact email shown in footer/privacy only when verified.
NEXT_PUBLIC_CONTACT_EMAIL=

# Social profiles. Leave blank to hide or omit the link.
NEXT_PUBLIC_INSTAGRAM_URL=

# Claimed Google Business Profile / Maps listing.
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Public workshop/showroom address. Leave blank until verified.
NEXT_PUBLIC_STREET_ADDRESS=
NEXT_PUBLIC_ADDRESS_LOCALITY=
NEXT_PUBLIC_ADDRESS_REGION=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=

# Coordinates. Published only as a matched pair.
NEXT_PUBLIC_LATITUDE=
NEXT_PUBLIC_LONGITUDE=

# Optional HTTPS endpoint for consultation leads.
LEAD_WEBHOOK_URL=

# Optional shared secret. Requests include X-Savoy-Signature when set.
LEAD_WEBHOOK_SECRET=
