# SAVOY environment
# Copy to .env.local and fill only verified values.

# Canonical site origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=

# Business WhatsApp, international format without "+" or spaces.
# Leave blank until verified; CTAs fall back to the planner anchor.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact email shown in footer/privacy only when verified.
NEXT_PUBLIC_CONTACT_EMAIL=

# Social profiles. Leave blank to hide or omit the link.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_THREADS_URL=

# Claimed Google Business Profile / Maps listing.
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Public workshop/showroom address. Leave blank until verified.
NEXT_PUBLIC_STREET_ADDRESS=
NEXT_PUBLIC_ADDRESS_LOCALITY=
NEXT_PUBLIC_ADDRESS_REGION=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=

# Coordinates. Published only as a matched pair.
NEXT_PUBLIC_LATITUDE=
NEXT_PUBLIC_LONGITUDE=

# Fixed weekly hours. Published only when all three are filled in.
# Days: comma-separated English weekday names, e.g. "Monday, Tuesday".
NEXT_PUBLIC_OPENING_DAYS=
NEXT_PUBLIC_OPENING_TIME=
NEXT_PUBLIC_CLOSING_TIME=

# Founding year. Leave blank until confirmed.
NEXT_PUBLIC_FOUNDED_YEAR=

# Schema.org price band, e.g. "Rp" or "Rp5.000.000 - Rp150.000.000".
NEXT_PUBLIC_PRICE_RANGE=

# "true" to show the testimonials section once real quotes replace placeholders.
NEXT_PUBLIC_SHOW_TESTIMONIALS=

# Optional HTTPS endpoint for consultation leads.
LEAD_WEBHOOK_URL=

# Optional shared secret. Requests include X-Savoy-Signature when set.
LEAD_WEBHOOK_SECRET=

# Admin panel (/admin). All three are required or the panel stays disabled.
# ADMIN_SECRET: `npm run admin:secret`. ADMIN_PASSWORD_HASH: `npm run admin:password`.
ADMIN_USERNAME=
ADMIN_SECRET=
ADMIN_PASSWORD_HASH=

# SMTP for the public-review email notification (src/lib/email.ts). All four
# of HOST/USER/PASS plus a numeric PORT are required, or notifications fall
# back to a server-console log instead of sending. Port 465 is implicit TLS;
# port 587 is STARTTLS - `src/lib/email.ts` picks TLS mode from whichever
# port you set here (secure: port === 465), so state the port your provider
# actually issued rather than assuming 465.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional "From" header for that email. Falls back to SMTP_USER, then to a
# generic SAVOY address, if left blank.
SMTP_FROM=

# Inbox that receives new-review notifications. Falls back to
# info@savoyinterior.com (the address already hard-coded as this project's
# default) when left blank - confirm with the business owner whether that
# inbox is still the right one before relying on the fallback in production.
REVIEW_NOTIFICATION_EMAIL=
